VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel env vars / local scripts) — never prefix with VITE_
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_STT_MODEL=scribe_v1
# Monthly character cap for recording (Starter plan = 30,000 credits)
ELEVENLABS_MONTHLY_CAP=28000
